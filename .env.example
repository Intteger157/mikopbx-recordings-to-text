# Copy to .env and customize (docker compose reads this file automatically)
POSTGRES_USER=whisper
POSTGRES_PASSWORD=whisper
POSTGRES_DB=whisper

JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32
CORS_ORIGINS=http://localhost:5173,http://192.168.31.76:5173

SUPERADMIN_USERNAME=admin
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change-me-strong-password

WHISPER_MODEL=medium
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=6
PBX_TIMEZONE=Europe/Moscow
# MikoPBX rejects anything above 180 requests per minute with HTTP 429.
# Raise this only after raising rate_limit_requests_api on the PBX itself.
PBX_REQUESTS_PER_MINUTE=150
